# SoftPip The Enforcer — Environment Template
# Copy to .env and secure permissions: chmod 600 .env

# Deriv API Token (Must have 'Read' and 'Trade' scopes ONLY. Strictly no payments/admin)
DERIV_API_TOKEN=your_deriv_api_token_here

# Telegram Alerts & Remote Control
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_private_chat_id_here
